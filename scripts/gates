#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
build_dir="$(cd "${NM_BUILD_DIR:-$repo_root/build}" && pwd)"
export NM_REFERENCE_ROOT="$(scripts/reference)"
export NM_RENDER="$build_dir/nm-dump"
export NM_REGISTRY_DUMP="$build_dir/nm-dump-registry"
export NM_CATALOG_EFFECTS_DIR="$build_dir/catalog/effects"
export NM_MIDI_STATE_DUMP="$build_dir/nm-dump-midi-state"
export NM_AUDIO_STATE_DUMP="$build_dir/nm-dump-audio-state"
export NM_OBJ_PARSER_DUMP="$build_dir/nm-dump-obj-parser"
export NM_DSL="$build_dir/nm-dump"
export NM_PROGRAM_STATE="$build_dir/nm-dump"
export NM_JSYNTAX_DUMP="$build_dir/nm-dump-js-syntax"
export NM_DIFF_EVIDENCE_DIR="$repo_root/.cache/evidence"

exec "${NM_PYTHON:-python3}" tools/run_gates.py
