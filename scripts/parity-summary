#!/usr/bin/env bash
# scripts/parity-summary [case-id ...]
#
# Renders the parity cases with this port and grades each against a golden minted
# by the reference engine's WebGPU backend in the same run (its WebGL2 backend
# with NM_GOLDEN_BACKEND=webgl2), then prints one line:
#
#   PARITY-SUMMARY {"expected":N,"executed":N,"exact":N,"strict":N,"near":N,"defer":N,"skip":N,"fail":N,"missing":N,"uninformative":N,"effects":N,"effects_evidenced":N}
#
# Cases: with case-id arguments, only those cases are expected; without, every
# parity/programs/*.dsl, parity/coverage/*.dsl, parity/portable/*.dsl (user
# Portable effects with their .portable.json sidecars), parity/timed/*.dsl (the
# timed tier, graded on sample series) and parity/curated/*.dsl (the sibling
# ports' curated programs) case is expected.
#
# The work is the canonical sweep, parity/sweep.py, run fresh (goldens minted in
# this run, candidates rendered by nm-render from the DSL with libnoisemaker's
# compiler, every case graded). nm-render does not produce text natively yet
# (tools/nm-render/main.cpp): it renders a text case without its text, which
# grades as fail. The ledger goes to a temporary file.
#
# Buckets (each case in exactly one):
#   exact   -- candidate pixels identical to an informative golden
#   strict  -- within the published contract: max-abs-diff <= 2.001 (8-bit units)
#              and global SSIM >= 0.98, not identical, on an informative golden
#   near    -- beyond the contract, within the case's recorded policy
#   defer   -- reserved (no case is deferred)
#   skip    -- the case could not execute here (infrastructure failure)
#   fail    -- rendered and graded outside every policy
#   missing -- no golden or no candidate was produced for the case
#   uninformative -- exact or strict on a golden that shows no structure
#              (uniform, more than 99% one colour, or luminance standard
#              deviation below one 8-bit level; parity/sweep.py): not parity
#              evidence, listed on stderr. A failure on such a golden is a fail.
# executed = exact + strict + near + fail + uninformative. Without case-id
# arguments the summary also counts the catalog effects and those with
# informative exact, strict or near evidence of their own (effects_evidenced; the
# others are listed on stderr). Exit 0 iff no case is near, failing, skipped or
# missing and (without case-id arguments) every catalog effect is evidenced; 1
# otherwise; 2 on an infrastructure failure (every case in skip).
#
# Environment:
#   NM_RENDER          candidate binary (default build/nm-render; build it with
#                      cmake --build build --target nm-render)
#   NM_CATALOG_EFFECTS_DIR  the built catalog's effect definitions (default
#                      build/catalog/effects)
#   NM_REFERENCE_ROOT  reference checkout; when unset, scripts/reference checks
#                      out the pinned revision of parity/reference.json
#   NM_GOLDEN_BACKEND  the reference backend that mints the goldens: webgpu (the
#                      gate, default) or webgl2 (the upstream report; the
#                      reference's own WebGPU and WebGL2 output differ on some
#                      cases, so this run is not a gate)
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CASE_ARGS=("$@")

count_cases() {
  if [ ${#CASE_ARGS[@]} -gt 0 ]; then echo ${#CASE_ARGS[@]}; return; fi
  find "$ROOT/parity/programs" "$ROOT/parity/coverage" "$ROOT/parity/portable" "$ROOT/parity/timed" \
    "$ROOT/parity/curated" -name '*.dsl' 2>/dev/null | wc -l | tr -d ' '
}
fail_infra() {
  echo "parity-summary: $1" >&2
  n="$(count_cases)"
  echo "PARITY-SUMMARY {\"expected\":$n,\"executed\":0,\"exact\":0,\"strict\":0,\"near\":0,\"defer\":0,\"skip\":$n,\"fail\":0,\"missing\":0,\"uninformative\":0}"
  exit 2
}

# ---- candidate ---------------------------------------------------------------
NM_RENDER="${NM_RENDER:-$ROOT/build/nm-render}"
[ -x "$NM_RENDER" ] || fail_infra "nm-render not found at $NM_RENDER (cmake --build build --target nm-render)"
export NM_RENDER
export NM_CATALOG_EFFECTS_DIR="${NM_CATALOG_EFFECTS_DIR:-$ROOT/build/catalog/effects}"
[ -d "$NM_CATALOG_EFFECTS_DIR" ] || fail_infra "no built catalog at $NM_CATALOG_EFFECTS_DIR"

# ---- reference -----------------------------------------------------------------
NM_REFERENCE_ROOT="$("$ROOT/scripts/reference")" || fail_infra "cannot check out the pinned reference"
export NM_REFERENCE_ROOT
if [ ! -f "$NM_REFERENCE_ROOT/node_modules/playwright/package.json" ]; then
  echo "[parity-summary] installing playwright into the reference checkout" >&2
  (cd "$NM_REFERENCE_ROOT" && npm install --no-save --no-audit --no-fund playwright@1.63.0 >&2) \
    || fail_infra "cannot install playwright for the golden minter"
  (cd "$NM_REFERENCE_ROOT" && npx playwright install chromium >&2) || fail_infra "cannot install chromium"
fi

# ---- python with numpy + pillow --------------------------------------------------
PY=python3
if ! "$PY" -c 'import numpy, PIL' 2>/dev/null; then
  if [ ! -x "$ROOT/.cache/parity-venv/bin/python" ]; then
    echo "[parity-summary] creating .cache/parity-venv" >&2
    python3 -m venv "$ROOT/.cache/parity-venv" && "$ROOT/.cache/parity-venv/bin/pip" install -q numpy pillow \
      || fail_infra "cannot create .cache/parity-venv with numpy and pillow"
  fi
  PY="$ROOT/.cache/parity-venv/bin/python"
fi

# ---- sweep + classification ---------------------------------------------------------
LEDGER="$(mktemp -t nm-parity-summary.XXXXXX)"
trap 'rm -f "$LEDGER" "$LEDGER.effects.json"' EXIT
"$PY" "$ROOT/parity/sweep.py" --ledger "$LEDGER" --golden-backend "${NM_GOLDEN_BACKEND:-webgpu}" \
  ${CASE_ARGS[@]+"${CASE_ARGS[@]}"} >&2
SWEEP_RC=$?
# The sweep fails when a tool fails even if every PNG it left grades exact.
[ -s "$LEDGER" ] || fail_infra "the sweep wrote no ledger (exit $SWEEP_RC)"
"$PY" - "$LEDGER" "$SWEEP_RC" ${CASE_ARGS[@]+"${CASE_ARGS[@]}"} <<'EOF'
import json, os, sys
rows = json.load(open(sys.argv[1]))
sweep_rc = int(sys.argv[2])
only = set(sys.argv[3:])
rows = [r for r in rows if not only or r["program"] in only]
c = dict(expected=len(rows), executed=0, exact=0, strict=0, near=0, defer=0, skip=0, fail=0, missing=0,
         uninformative=0)
outside = []
uninformative = []
for r in rows:
    b = r.get("bucket", r["verdict"])
    if b == "MISSING":
        c["missing"] += 1; outside.append(r["program"]); continue
    c["executed"] += 1
    if b == "EXACT": c["exact"] += 1
    elif b == "STRICT": c["strict"] += 1
    elif b == "UNINFORMATIVE": c["uninformative"] += 1; uninformative.append(r["program"])
    elif b == "NEAR": c["near"] += 1; outside.append(r["program"])
    else: c["fail"] += 1; outside.append(r["program"])
missing_effects = []
effects_file = sys.argv[1] + ".effects.json"
if not only and os.path.exists(effects_file):
    evidence = json.load(open(effects_file))
    missing_effects = sorted(k for k, v in evidence.items() if not v)
    c["effects"] = len(evidence)
    c["effects_evidenced"] = len(evidence) - len(missing_effects)
print("PARITY-SUMMARY " + json.dumps(c, separators=(",", ":")))
if outside:
    print("parity-summary: cases outside the published contract: " + " ".join(outside), file=sys.stderr)
if uninformative:
    print("parity-summary: passes on uninformative goldens (not evidence): " + " ".join(uninformative),
          file=sys.stderr)
if missing_effects:
    print("parity-summary: effects without informative exact or strict evidence: " + " ".join(missing_effects),
          file=sys.stderr)
if sweep_rc != 0:
    print(f"parity-summary: the sweep exited {sweep_rc} (the minter or nm-render failed, or a case is outside the contract)",
          file=sys.stderr)
ok = c["executed"] == c["expected"] and c["near"] + c["fail"] + c["missing"] + c["skip"] == 0 \
    and not missing_effects and sweep_rc == 0
sys.exit(0 if ok else 1)
EOF
