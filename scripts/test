#!/usr/bin/env bash
# Repository test entry point. Builds the GPU-free core and host helpers, runs
# their unit tests and the tool tests, then every parity gate against the
# reference at the lock in parity/reference.json. Exits nonzero on any failure.
#
# It needs CMake 3.22 or later, a C++20 compiler, Node.js 26, Git, network
# access and Python 3.12 or later. Where python3 is older (Debian bookworm has
# 3.11), it uses a newer interpreter on PATH or one that uv manages.
#
#   NM_TEST_BUILD_DIR  build directory (default: build-test)
#   NM_TEST_JOBS       parallel compile jobs (default: 2)
#   NM_PYTHON          Python interpreter to try first
#   NM_CHANGED_FILES   changed paths, one per line. When set, run only the
#                      tests that exercise those paths; when unset, run the
#                      whole suite exactly as before.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
build_dir="${NM_TEST_BUILD_DIR:-$repo_root/build-test}"
jobs="${NM_TEST_JOBS:-4}"

python=""
for candidate in "${NM_PYTHON:-}" python3.14 python3.13 python3.12 python3; do
  [[ -n "$candidate" ]] && command -v "$candidate" >/dev/null 2>&1 || continue
  if "$candidate" -c 'import sys; sys.exit(sys.version_info < (3, 12))'; then
    python="$(command -v "$candidate")"
    break
  fi
done
if [[ -z "$python" ]] && command -v uv >/dev/null 2>&1; then
  python="$(uv python find '>=3.12' 2>/dev/null || true)"
fi
if [[ -z "$python" ]]; then
  echo "scripts/test: no Python 3.12 or later found (set NM_PYTHON)" >&2
  exit 1
fi

run_core=true; run_tools=true; run_gates=true
if [[ -n "${NM_CHANGED_FILES:-}" ]]; then
  run_core=false; run_tools=false; run_gates=false
  while IFS= read -r path; do
    [[ -z "$path" ]] && continue
    case "$path" in
      # Core sources: the native tests and the parity gates exercise them.
      src/*|include/*|host/*|tests/core/*|tests/CMakeLists.txt|CMakeLists.txt|cmake/*)
        run_core=true; run_gates=true ;;
      parity/*) run_gates=true ;;
      tools/*|scripts/*|tests/tools/*) run_tools=true ;;
      *) run_tools=true ;;
    esac
  done <<< "$NM_CHANGED_FILES"
  # The parity gates compare the native build, so a gate run needs the build.
  $run_gates && run_core=true
fi

generator=()
if command -v ninja >/dev/null 2>&1; then generator=(-G Ninja); fi

if $run_core; then
  cmake -S . -B "$build_dir" ${generator[@]+"${generator[@]}"} -DCMAKE_BUILD_TYPE=Release \
    -DNM_BUILD_GPU=OFF -DPython3_EXECUTABLE="$python"
  cmake --build "$build_dir" --parallel "$jobs"
  "$python" tools/run_gates.py --run ctest --test-dir "$build_dir" --output-on-failure --timeout 300
fi
if $run_tools; then
  "$python" tools/run_gates.py --run "$python" -m unittest discover -s tests/tools -t .
fi
if $run_gates; then
  NM_BUILD_DIR="$build_dir" NM_PYTHON="$python" scripts/gates
fi
echo "scripts/test: all tests and gates passed"
