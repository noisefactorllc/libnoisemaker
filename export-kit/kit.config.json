{
  "configVersion": 1,
  "id": "libnoisemaker",
  "series": "0.1",
  "shaderSource": "kit",
  "engineSource": "kit",
  "pageTemplate": false,
  "subtrees": [
    { "from": "CMakeLists.txt", "to": "engine/CMakeLists.txt" },
    { "from": "LICENSE", "to": "engine/LICENSE" },
    { "from": "cmake", "to": "engine/cmake" },
    { "from": "include", "to": "engine/include" },
    { "from": "src", "to": "engine/src" },
    { "from": "parity/reference.json", "to": "engine/parity/reference.json" },
    { "from": "third_party/dawn.lock.json", "to": "engine/third_party/dawn.lock.json" },
    { "from": "third_party/licenses", "to": "engine/third_party/licenses" },
    { "from": "tools/fetch_dawn.py", "to": "engine/tools/fetch_dawn.py" },
    { "from": "tools/build_dawn.py", "to": "engine/tools/build_dawn.py" },
    { "from": "tools/catalog/fetch-catalog.mjs", "to": "engine/tools/catalog/fetch-catalog.mjs" },
    { "from": "tools/catalog/build-catalog.mjs", "to": "engine/tools/catalog/build-catalog.mjs" },
    { "from": "tools/catalog/extract-runtime-shaders.mjs", "to": "engine/tools/catalog/extract-runtime-shaders.mjs" },
    { "from": "tools/catalog/embed.py", "to": "engine/tools/catalog/embed.py" },
    { "from": "tools/nm-dump", "to": "engine/tools/nm-dump" },
    { "from": "tools/nm-render", "to": "engine/tools/nm-render" }
  ],
  "licenses": [
    { "from": "LICENSE", "to": "LICENSES/libnoisemaker-LICENSE.txt" },
    { "from": "src/core/catalog/catalog-NOTICES.txt", "to": "LICENSES/catalog-NOTICES.txt" },
    { "from": "src/core/js/acorn-LICENSE.txt", "to": "LICENSES/acorn-LICENSE.txt" },
    { "from": "src/host/LICENSE-skia.txt", "to": "LICENSES/Skia-LICENSE.txt" },
    { "from": "third_party/licenses/Dawn-LICENSE.txt", "to": "LICENSES/Dawn-LICENSE.txt" },
    { "from": "third_party/licenses/abseil-cpp-LICENSE.txt", "to": "LICENSES/abseil-cpp-LICENSE.txt" },
    { "from": "third_party/licenses/SPIRV-Tools-LICENSE.txt", "to": "LICENSES/SPIRV-Tools-LICENSE.txt" },
    { "from": "third_party/licenses/SPIRV-Headers-LICENSE.txt", "to": "LICENSES/SPIRV-Headers-LICENSE.txt" },
    { "from": "third_party/licenses/Vulkan-Headers-LICENSE.md", "to": "LICENSES/Vulkan-Headers-LICENSE.md" },
    { "from": "third_party/licenses/Vulkan-Headers-Apache-2.0.txt", "to": "LICENSES/Vulkan-Headers-Apache-2.0.txt" },
    { "from": "third_party/licenses/Vulkan-Headers-MIT.txt", "to": "LICENSES/Vulkan-Headers-MIT.txt" },
    { "from": "third_party/licenses/Vulkan-Utility-Libraries-LICENSE.md", "to": "LICENSES/Vulkan-Utility-Libraries-LICENSE.md" },
    { "from": "third_party/licenses/Vulkan-Utility-Libraries-Apache-2.0.txt", "to": "LICENSES/Vulkan-Utility-Libraries-Apache-2.0.txt" }
  ],
  "requireFiles": [
    "engine/CMakeLists.txt",
    "engine/LICENSE",
    "engine/cmake/Dawn.cmake",
    "engine/cmake/DawnOptions.cmake",
    "engine/cmake/noisemakerConfig.cmake.in",
    "engine/include/noisemaker/core.h",
    "engine/src/core/catalog/catalog.cpp",
    "engine/src/host/LICENSE-skia.txt",
    "engine/parity/reference.json",
    "engine/third_party/dawn.lock.json",
    "engine/tools/fetch_dawn.py",
    "engine/tools/build_dawn.py",
    "engine/tools/catalog/fetch-catalog.mjs",
    "engine/tools/catalog/build-catalog.mjs",
    "engine/tools/catalog/extract-runtime-shaders.mjs",
    "engine/tools/catalog/embed.py",
    "engine/tools/nm-dump/CMakeLists.txt",
    "engine/tools/nm-render/CMakeLists.txt",
    "engine/tools/nm-render/main.cpp",
    "LICENSES/libnoisemaker-LICENSE.txt",
    "LICENSES/catalog-NOTICES.txt",
    "LICENSES/acorn-LICENSE.txt",
    "LICENSES/Skia-LICENSE.txt",
    "LICENSES/Dawn-LICENSE.txt",
    "LICENSES/abseil-cpp-LICENSE.txt",
    "LICENSES/SPIRV-Tools-LICENSE.txt",
    "LICENSES/SPIRV-Headers-LICENSE.txt",
    "LICENSES/Vulkan-Headers-LICENSE.md",
    "LICENSES/Vulkan-Headers-Apache-2.0.txt",
    "LICENSES/Vulkan-Headers-MIT.txt",
    "LICENSES/Vulkan-Utility-Libraries-LICENSE.md",
    "LICENSES/Vulkan-Utility-Libraries-Apache-2.0.txt"
  ],
  "forbidDirs": [
    "shaders",
    "engine/tests",
    "engine/docs",
    "engine/scripts",
    "engine/.github",
    "engine/.cache",
    "engine/build",
    "engine/parity/programs",
    "engine/parity/corpus",
    "engine/parity/coverage",
    "engine/parity/out"
  ],
  "requiredTokens": {
    "README.template.md": ["NM_PROGRAM_NAME", "NM_EFFECT_LIST", "NM_ENGINE_VERSION"]
  },
  "inject": {
    "type": "dsl-file",
    "target": "program.dsl"
  },
  "compat": {
    "mode": "list",
    "fromJsonList": "export-kit/compat-effects.json"
  },
  "engineBytesFrom": ["engine/"]
}
